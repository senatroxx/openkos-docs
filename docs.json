{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OpenKOS Documentation",
  "colors": {
    "primary": "#096CF8",
    "light": "#3D89FF",
    "dark": "#1F67DA"
  },
  "favicon": "/logo/openkos-icon.svg",
  "navigation": {
    "pages": [
      "introduction",
      "about",
      "installation",
      "quickstart",
      "deployment",
      "contributing",
      {
        "group": "Users",
        "pages": [
          "index",
          "users/dashboard-and-billing",
          "users/billing-and-payments",
          "users/properties-and-units",
          "users/tenants-and-leases",
          "users/daily-operations",
          "users/maintenance",
          "users/settings-and-access",
          "users/tenant-portal"
        ]
      },
      {
        "group": "Developers",
        "pages": [
          "developers/index",
          "developers/setup",
          "developers/architecture",
          "developers/plugins",
          "developers/integrations"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/openkos-light.png",
    "dark": "/logo/openkos-dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/senatroxx/openkos"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/senatroxx/openkos"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/introduction",
      "permanent": true
    }
  ]
}
